<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer><defaultDocument><files><clear/><add value="index.html"/></files></defaultDocument><httpProtocol><customHeaders><remove name="X-Robots-Tag"/><add name="X-Robots-Tag" value="noindex, nofollow"/><remove name="X-Frame-Options"/><add name="X-Frame-Options" value="DENY"/><remove name="Referrer-Policy"/><add name="Referrer-Policy" value="no-referrer"/><remove name="Cache-Control"/><add name="Cache-Control" value="no-store"/></customHeaders></httpProtocol><security><requestFiltering><requestLimits maxAllowedContentLength="8192"/></requestFiltering></security></system.webServer></configuration>
