<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer><rewrite><rules><rule name="AdaPanel-Admin-Moved" stopProcessing="true"><match url="^(?:admin\.html)?$"/><action type="Redirect" url="/admin/" redirectType="Permanent" appendQueryString="false"/></rule></rules></rewrite><httpProtocol><customHeaders><remove name="X-Robots-Tag"/><add name="X-Robots-Tag" value="noindex, nofollow"/><remove name="X-Frame-Options"/><add name="X-Frame-Options" value="DENY"/><remove name="Referrer-Policy"/><add name="Referrer-Policy" value="no-referrer"/></customHeaders></httpProtocol><security><requestFiltering><requestLimits maxAllowedContentLength="4096"/></requestFiltering></security></system.webServer></configuration>
