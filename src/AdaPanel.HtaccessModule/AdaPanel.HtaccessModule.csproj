<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 ZORUNLU, tercih DEGIL. IIS'in yonetilen modul sozlesmesi System.Web.IHttpModule'dur;
         System.Web .NET (Core) icinde YOKTUR ve net8 derlemesi CLR 4 icinde yuklenemez. Bu yuzden
         bu proje deponun geri kalanindan (net8.0) AYRI bir hedef cerceve kullanir ve
         Directory.Build.props'taki <TargetFramework>net8.0</TargetFramework> degerini EZER.

         OLCULDU: bu makinede net48 derlemesi CEVRIMDISI yapilabiliyor &#8212; .NET Framework hedefleme
         paketi kurulu DEGIL, ama Microsoft.NETFramework.ReferenceAssemblies paketi NuGet
         onbelleginde mevcut ve derleme onunla yesil gecti. -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AdaPanel.HtaccessModule</AssemblyName>
    <RootNamespace>AdaPanel.HtaccessModule</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- ACILDI. Motorun dosyalari Infrastructure'da ortulu using'lerle (System, System.Linq,
         System.Collections.Generic, System.IO ...) yaziliyor. Kapali biraksaydik AYNI dosyalarin
         iki hedefte FARKLI using basliklari gerektirmesi gerekirdi &#8212; yani tek kaynak kurali
         fiilen bozulurdu. Bu projenin kendi dosyalari using'lerini zaten acikca yaziyor. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- Bu proje w3wp icinde calisir; hicbir testi kendisi barindirmaz. Paylasilan mantik
         AdaPanel.Infrastructure icinde net8 olarak DA derlenir ve testler ORADAN kosar. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- GUCLU AD: GAC'a kurulmanin ON KOSULU. GAC secildi cunku applicationHost.config'e global
         kaydedilen yonetilen bir modulun derlemesi, uygulamalarin /bin klasorunde OLAMAZ
         (her uygulamanin ayri bir probing yolu var) &#8212; Microsoft'un modules/add belgesi de
         ornekleri GAC uzerinden veriyor.

         .snk DEPOYA GIRIYOR ve bu BILEREK boyle. Guclu ad bir GUVENLIK siniri DEGILDIR (Microsoft
         bunu acikca soyler): kimlik/surumleme icindir. Gizli tutulmasi gereken sey KOD IMZALAMA
         sertifikasidir, o ayri bir konudur ve depoda yoktur. Anahtari gizleseydik derleme
         yeniden uretilemez olurdu; kazanc sifir, bedel buyuk olurdu. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>AdaPanel.HtaccessModule.snk</AssemblyOriginatorKeyFile>

    <!-- ASSEMBLYVERSION SABITLENDI (1.0.0.0) ve panel surumunu TAKIP ETMEZ.
         Bu bir suslemem degil, olculmus bir arizanin onlenmesi:

         Directory.Build.props butun projelere <Version>0.6.6</Version> veriyor ve AssemblyVersion
         bundan TUREMEKTEYDI (ilk derlemede olculdu: "AdaPanel.HtaccessModule, Version=0.6.6.0").
         GAC kimligi AssemblyVersion'i ICERIR ve applicationHost.config'teki `type` dizesi de
         Version=... yazar. Yani her panel surumunde:
           - GAC'a YENI bir yan yana surum kurulurdu (eskiler asla temizlenmezdi),
           - applicationHost.config'teki kayit ESKI surumu gostermeye devam ederdi,
           - IIS eski DLL'i yuklemeye devam ederdi -> guncelleme YAPILMIS gorunur, modul ESKI kalirdi.
         Sessiz, birikimli ve teshisi cok zor bir ariza. Sabit AssemblyVersion ile GAC kimligi
         degismez, kurulum ayni girdiyi YERINDE degistirir, kayit satirina hic dokunulmaz.

         Hangi yapinin kurulu oldugu FileVersion'dan okunur (panel surumunu o tasir). -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- AssemblyVersion sabitlenince FileVersion de ona esitlenmisti (olculdu). Panel surumunu
         geri baglar: sunucuda "hangi yapi kurulu" sorusunun tek dogru cevabi budur. -->
    <FileVersion>$(Version)</FileVersion>

    <!-- AnyCPU: PHP siteleri icin 32-bit havuz (enable32BitAppOnAppPool) COK yaygin. Platformu
         sabitlemek o havuzlarda modulu sessizce olduraurdu. Bu yuzden kayitta da bitness on kosulu
         YOK (bkz. HtaccessModuleRegistration.PreCondition). -->
    <PlatformTarget>AnyCPU</PlatformTarget>

    <!-- CS8602 (olasi null basvuru) BU PROJEDE susturuldu &#8212; ve yalniz burada.
         OLCULDU: motorun kaynaklari baglandiktan sonra bu derlemede 6 CS8602 cikti, ALTISI DA
         paylasilan dosyalarda (PathContainment, HtaccessEvaluationResult, HtaccessInterpolator,
         HtaccessRewriteModel x2, HtaccessEngine); modulun kendi bes dosyasinda SIFIR.
         Hepsi ayni sebepten: net48 basvuru derlemelerinde null aciklamalari (`[NotNullWhen]`,
         `[NotNullIfNotNull]`) YOKTUR, bu yuzden `string.IsNullOrWhiteSpace(x)` denetiminden sonra
         derleyici `x`'i daraltamiyor. AYNI dosyalar AdaPanel.Infrastructure'da net8 ile ve TAM
         null cozumlemesiyle derleniyor; gercek bir null hatasi ORADA uyari verir. Yani burada
         susturulan sey bilgi degil, GURULTU. Kalici 6 uyari birakmak, uyarilara bakmamayi
         ogretirdi. -->
    <NoWarn>$(NoWarn);CS8602</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <!-- PAYLASILAN BARINDIRMA MANTIGI &#8212; KAYNAK OLARAK baglanir, derleme basvurusu olarak DEGIL.
       ============================================================================
       Bu, projenin en onemli yapi kararidir ve sebebi olculmus bir kisittir:
       cekirdek motor ve panel net8.0'dir, bu modul net48'dir. Bir net8 derlemesi net48 CLR'inda
       YUKLENEMEZ &#8212; ProjectReference vermek derleme zamaninda bile calismaz.

       Uc secenek vardi:
         (a) Mantigi bu projeye KOPYALAMAK  -> iki kaynak, kacinilmaz sapma. Deponun "tekrari tek
             kaynaga cikar" kuralina dogrudan aykiri. ELENDI.
         (b) AdaPanel.Infrastructure'i cok hedefli yapmak -> baska ekibin dosyasi; ayrica
             Infrastructure MailKit/Npgsql/EF gibi net48'de olmayan bagimliliklar tasiyor. ELENDI.
         (c) AYNI .cs dosyalarini iki projede DERLEMEK. Tek kaynak, iki cikti. SECILDI.

       Baglanan dosyalar net48 uyumlu olmak ZORUNDA (System.Text.Json, Path.Join, HashCode.Combine,
       string.Contains(char) YOK). Bu kural dosyalarin kendi basliklarinda da yaziyor.

       Dosyalar TEK TEK sayiliyor, joker (*.cs) KULLANILMIYOR: Hosting klasorune ileride net8'e ozgu
       bir dosya eklendiginde joker onu sessizce buraya da cekip net48 derlemesini kirardi. Acik
       liste, o hatayi "derleme kirildi" yerine "listeye eklemedim" seviyesinde tutar. -->
  <ItemGroup>
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\HtaccessHostingPaths.cs" Link="Shared\HtaccessHostingPaths.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\HtaccessSwitchFile.cs" Link="Shared\HtaccessSwitchFile.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\HtaccessRuntimeGate.cs" Link="Shared\HtaccessRuntimeGate.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\HtaccessFailSafe.cs" Link="Shared\HtaccessFailSafe.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\HtaccessFileCache.cs" Link="Shared\HtaccessFileCache.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\HtaccessModuleRegistration.cs" Link="Shared\HtaccessModuleRegistration.cs" />
    <!-- KORUMALI DIZINLER: betimleyici bicimi + istek yolundaki kapi. Panel YAZAR, modul OKUR;
         iki taraf da AYNI kaynagi derler. Ayri yazilsaydi panel bir klasore/bicime yazar, modul
         baskasini arardi &#8212; bu dosyalarin var olma sebebi olan sessiz arizanin ta kendisi. -->
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\ProtectedDirectoryFile.cs" Link="Shared\ProtectedDirectoryFile.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\ProtectedDirectoryGate.cs" Link="Shared\ProtectedDirectoryGate.cs" />
  </ItemGroup>

  <!-- CEKIRDEK MOTOR &#8212; ayni kaynak, ikinci cikti.
       ============================================================================
       Yukaridaki blokta secilen (c) siki artik motorun TAMAMINA uygulaniyor: motorun .cs
       dosyalari bu net48 projesinde de derleniyor. (b) "Infrastructure'i cok hedefli yap"
       secenegi bugun de gecerli DEGIL ve sebebi olculdu: Infrastructure MailKit / Npgsql /
       Microsoft.Data.SqlClient / EF tasiyor ve <FrameworkReference Microsoft.AspNetCore.App>
       ile derleniyor &#8212; bunlarin hicbiri net48'de yok. Cok hedefli yapmak, ozelligin
       ILGISIZ 200+ dosyayi net48'e tasimaya bagimli olmasi demekti.

       Panel tarafi DEGISMEDI: AdaPanel.Infrastructure hala tek hedefli net8.0-windows ve
       ayni dosyalari kendi derlemesine aliyor. Bu blok yalniz IKINCI bir cikti uretir.

       Yine TEK TEK sayiliyor (joker YOK): Htaccess klasorune net8'e ozgu yeni bir dosya
       eklendiginde joker onu sessizce buraya cekip net48 derlemesini kirardi.

       BILEREK DISARIDA BIRAKILANLAR (ikisi de PANEL tarafidir, istek yolunda CALISMAZ):
         - HtaccessPanelService.cs  -> Microsoft.Extensions.Logging/Options + Infrastructure.Options
         - Hosting/HtaccessSwitchStore.cs -> System.Security.AccessControl ile ACL yazar (panel yazar,
           modul yalniz OKUR; okuma HtaccessSwitchFile'da).
       Bunlari da baglamak, modulun GAC'ta cozemeyecegi NuGet bagimliliklarini surukleyebilirdi. -->
  <ItemGroup>
    <!-- AdaPanel.Core: motorun sozlesmesi ve DTO'lari. Butun dosya net48 uyumlu. -->
    <Compile Include="..\AdaPanel.Core\Common\PathContainment.cs" Link="Shared\Core\PathContainment.cs" />
    <!-- AYRILMIS AYGIT ADLARI (CON, NUL, COM1...) &#8212; TEK KAYNAK.
         Burada baglanmasinin sebebi olculmus bir borctur: HtaccessHostingPaths.cs bu projede de
         derlendigi icin kural bir sure ONUN ICINDE IKINCI KEZ yazili durdu ve iki kopyanin
         sapmamasi bir parite testine emanet edilmisti. Bu depoda "elle yazilmis liste kayar"
         hatasi bes kez isirdi; dosya baglaninca kopya kaldirildi ve sapma yapisal olarak
         imkansiz oldu. Dosya BU AMACLA net48 uyumlu yazilmisti (Substring, System.Range yok,
         System.Linq yok) &#8212; kendi basliginda da yaziyor.
         MUTASYONLA OLCULDU: bu satir kaldirilinca net48 derlemesi KIRILIYOR, yani bag gercekten
         yuk tasiyor ve kopyanin geri gelmesi "derleme kirildi" seviyesinde gorunur olur. -->
    <Compile Include="..\AdaPanel.Core\Common\WindowsReservedNames.cs" Link="Shared\Core\WindowsReservedNames.cs" />
    <Compile Include="..\AdaPanel.Core\Interfaces\IHtaccessEngine.cs" Link="Shared\Core\IHtaccessEngine.cs" />
    <Compile Include="..\AdaPanel.Core\Dtos\Htaccess\HtaccessDiagnostic.cs" Link="Shared\Core\HtaccessDiagnostic.cs" />
    <Compile Include="..\AdaPanel.Core\Dtos\Htaccess\HtaccessDocument.cs" Link="Shared\Core\HtaccessDocument.cs" />
    <Compile Include="..\AdaPanel.Core\Dtos\Htaccess\HtaccessEvaluationResult.cs" Link="Shared\Core\HtaccessEvaluationResult.cs" />
    <Compile Include="..\AdaPanel.Core\Dtos\Htaccess\HtaccessInspectionResult.cs" Link="Shared\Core\HtaccessInspectionResult.cs" />
    <Compile Include="..\AdaPanel.Core\Dtos\Htaccess\HtaccessLimits.cs" Link="Shared\Core\HtaccessLimits.cs" />
    <Compile Include="..\AdaPanel.Core\Dtos\Htaccess\HtaccessRequestContext.cs" Link="Shared\Core\HtaccessRequestContext.cs" />

    <!-- Motorun kendisi. -->
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessPortableApi.cs" Link="Shared\Engine\HtaccessPortableApi.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessAccessControl.cs" Link="Shared\Engine\HtaccessAccessControl.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessCascadeLoader.cs" Link="Shared\Engine\HtaccessCascadeLoader.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessConfiguration.cs" Link="Shared\Engine\HtaccessConfiguration.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessConfigurationBuilder.cs" Link="Shared\Engine\HtaccessConfigurationBuilder.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessDirectiveCatalog.cs" Link="Shared\Engine\HtaccessDirectiveCatalog.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessEngine.cs" Link="Shared\Engine\HtaccessEngine.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessFileSystem.cs" Link="Shared\Engine\HtaccessFileSystem.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessInterpolator.cs" Link="Shared\Engine\HtaccessInterpolator.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessParser.cs" Link="Shared\Engine\HtaccessParser.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessRegexCache.cs" Link="Shared\Engine\HtaccessRegexCache.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessRewriteModel.cs" Link="Shared\Engine\HtaccessRewriteModel.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessRewriteRunner.cs" Link="Shared\Engine\HtaccessRewriteRunner.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\HtaccessServerVariables.cs" Link="Shared\Engine\HtaccessServerVariables.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Htpasswd\ApacheMd5Crypt.cs" Link="Shared\Engine\ApacheMd5Crypt.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Htpasswd\BCryptVerifier.cs" Link="Shared\Engine\BCryptVerifier.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Htpasswd\BlowfishInitialState.cs" Link="Shared\Engine\BlowfishInitialState.cs" />
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Htpasswd\HtpasswdFile.cs" Link="Shared\Engine\HtpasswdFile.cs" />

    <!-- KOPRU: motorun sonucunu modulun uygulayabilecegi karara ceviren, net8 testlerinden
         kosan mantik. Uyarlayici (HtaccessModuleEngineAdapter.cs) bu projenin KENDI dosyasidir
         ve joker ile zaten derleniyor; burada yalniz koprunun kaynagi baglaniyor. -->
    <Compile Include="..\AdaPanel.Infrastructure\Htaccess\Hosting\HtaccessEngineBridge.cs" Link="Shared\Engine\HtaccessEngineBridge.cs" />
  </ItemGroup>

</Project>
