{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AdaPanel": "Data Source=%ProgramData%\\AdaPanel\\data\\adapanel.db"
  },
  "Panel": {
    "ServiceName": "AdaPanel",
    "DataRoot": "%ProgramData%\\AdaPanel",
    "DefaultLanguage": "tr",
    "PreferredHttpsPort": 8888,
    "SecureEntryPath": "panel",
    "AllowHttpFallback": false,
    "AuthCookieName": "AdaPanel.Auth",
    "TotpIssuer": "AdaPanel",
    "LoginLockoutMinutes": 15,
    "AllowInternalOutboundTargets": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  }
}
